@model Gs1Location
@{ ViewData["Title"] = $"Sửa địa điểm GS1 {Model.Code}"; }
<div class="card" style="max-width:860px"><div class="card-body">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <div class="row g-3 mb-2">
            <div class="col-md-4"><label class="form-label small text-muted">Mã địa điểm GS1</label><input value="@Model.Code" class="form-control" disabled /></div>
            <div class="col-md-8"><label class="form-label small text-muted">Tên địa điểm (GLNName) <span class="text-danger">*</span></label><input name="name" value="@Model.Name" class="form-control" /></div>
        </div>
        <div class="row g-3 mb-2">
            <div class="col-md-4"><label class="form-label small text-muted">Vĩ độ (GPSLat)</label><input name="gpsLat" value="@Model.GpsLat" class="form-control" /></div>
            <div class="col-md-4"><label class="form-label small text-muted">Kinh độ (GPSLong)</label><input name="gpsLong" value="@Model.GpsLong" class="form-control" /></div>
            <div class="col-md-4"><label class="form-label small text-muted">Đơn vị sở hữu (OrgID) <span class="text-danger">*</span></label><input name="orgCode" value="@Model.OrgCode" class="form-control" /></div>
        </div>
        <div class="row g-3 mb-2">
            <div class="col-md-8"><label class="form-label small text-muted">Ghi chú</label><input name="remark" value="@Model.Remark" class="form-control" /></div>
            <div class="col-md-4 d-flex align-items-end">
                <div class="form-check"><input class="form-check-input" type="checkbox" name="isActive" value="true" checked="@Model.IsActive" /><label class="form-check-label small">Đang hoạt động</label></div>
            </div>
        </div>
        <div class="alert alert-light border small mb-3"><i class="bi bi-info-circle me-1"></i>Mã GLN không đổi được sau khi tạo; tên địa điểm và đơn vị sở hữu bắt buộc.</div>
        <div class="mt-3"><button class="btn btn-primary"><i class="bi bi-save me-1"></i>Lưu</button> <a href="/Gs1Location" class="btn btn-outline-secondary">Hủy</a></div>
    </form>
</div></div>