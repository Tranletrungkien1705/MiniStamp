@model BoxHistory
@{
    ViewData["Title"] = $"Lịch sử đóng hộp {Model.BoxNo}";
    var shown = Model.Lines.Take(60).ToList();
}
<div class="card mb-3"><div class="card-body">
    <div class="d-flex justify-content-between flex-wrap gap-2">
        <div>
            <h5 class="fw-bold mb-1">Hộp @Model.BoxNo</h5>
            <div class="text-muted small">
                Hành động <b>@Model.FunctionName</b> · loại <b>@Model.RefType</b> ·
                <b>@Model.QtyIDNo</b> tem · đóng lúc @Model.CreateDTimeUTC.ToString("dd/MM/yyyy HH:mm")
            </div>
            @if (Model.RestoredAt != null)
            {
                <div class="small text-secondary mt-1"><i class="bi bi-check2-circle me-1"></i>Đã khôi phục lúc @Model.RestoredAt.Value.ToString("dd/MM/yyyy HH:mm") bởi @Model.RestoredBy</div>
            }
        </div>
        <div class="d-flex gap-2 align-self-start">
            <a href="/BoxHistory" class="btn btn-sm btn-outline-primary">Danh sách lịch sử</a>
            @if (Model.RestoredAt == null)
            {
                <form method="post" action="/BoxHistory/Restore/@Model.Id" onsubmit="return confirm('Khôi phục @Model.QtyIDNo tem vào hộp @Model.BoxNo?');">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-sm btn-primary"><i class="bi bi-arrow-counterclockwise me-1"></i>Khôi phục hộp</button>
                </form>
            }
        </div>
    </div>
</div></div>

<div class="card"><div class="card-body">
    <h6 class="fw-bold mb-1">Tem trong lần đóng này (hiện @shown.Count/@Model.QtyIDNo)</h6>
    <p class="text-muted small">Khi khôi phục: tem đã xuất bán hoặc đang trùng ở hộp khác sẽ được đưa vào bảng <b>tem trung tính</b> (nghi vấn); các tem còn lại được gắn lại vào hộp.</p>
    <div class="row g-3">
        @foreach (var l in shown)
        {
            <div class="col-6 col-md-3 col-lg-2 text-center">
                <img src="/Stamp/Qr?code=@l.QrId&px=4" class="img-fluid border rounded" style="max-width:110px" alt="QR" />
                <div class="small mt-1" style="font-family:monospace">@l.QrId</div>
            </div>
        }
    </div>
</div></div>