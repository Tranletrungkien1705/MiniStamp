@model List<BoxHistory>
@{ ViewData["Title"] = "Khôi phục hộp tem"; }
<div class="card"><div class="card-body">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h6 class="fw-bold mb-0">Lịch sử đóng hộp (Map_IDInBoxHist)</h6>
            <div class="text-muted small">Mỗi lần đóng tem vào hộp được ghi lại — có thể khôi phục lại khi cần.</div>
        </div>
        <form method="get" class="d-flex gap-2">
            <input name="boxNo" value="@ViewBag.BoxNo" class="form-control form-control-sm" placeholder="Lọc theo mã hộp…" style="width:200px" />
            <button class="btn btn-sm btn-outline-primary">Lọc</button>
        </form>
    </div>
    <table class="table table-hover align-middle">
        <thead><tr><th>Mã hộp</th><th>Hành động</th><th>Loại</th><th class="text-end">SL tem</th><th>Đóng lúc</th><th>Trạng thái</th></tr></thead>
        <tbody>
        @foreach (var h in Model)
        {
            <tr style="cursor:pointer" onclick="location.href='/BoxHistory/Detail/@h.Id'">
                <td class="fw-semibold">@h.BoxNo</td>
                <td class="small">@h.FunctionName</td>
                <td class="small">@h.RefType</td>
                <td class="text-end">@h.QtyIDNo.ToString("N0")</td>
                <td class="small text-muted">@h.CreateDTimeUTC.ToString("dd/MM/yyyy HH:mm")</td>
                <td>
                    @if (h.RestoredAt != null) { <span class="badge bg-secondary">Đã khôi phục</span> }
                    else { <span class="badge bg-success">Có thể khôi phục</span> }
                </td>
            </tr>
        }
        @if (Model.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-4">Chưa có lịch sử đóng hộp nào.</td></tr> }
        </tbody>
    </table>
</div></div>