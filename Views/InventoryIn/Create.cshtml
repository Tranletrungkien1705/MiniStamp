@{
    ViewData["Title"] = "Tạo phiếu nhập kho";
    var products = (List<Product>)ViewBag.Products;
}
<div class="card" style="max-width:860px"><div class="card-body">
    @if (products.Count == 0)
    {
        <div class="alert alert-warning">Chưa có sản phẩm. <a href="/Product/Create">Tạo sản phẩm</a> trước.</div>
    }
    else
    {
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="row g-3 mb-2">
                <div class="col-md-5"><label class="form-label small text-muted">Mã phiếu nhập</label><input name="invInNo" class="form-control" placeholder="Để trống sẽ tự sinh" /></div>
                <div class="col-md-7"><label class="form-label small text-muted">Ghi chú</label><input name="remark" class="form-control" placeholder="VD: Nhập kho lô sản xuất tháng 9" /></div>
            </div>
            <label class="form-label small text-muted">Chi tiết nhập kho (mỗi dòng 1 sản phẩm)</label>
            <table class="table table-sm align-middle" id="lines">
                <thead><tr><th style="width:45%">Sản phẩm</th><th style="width:20%">Số lượng</th><th style="width:25%">Ngày sản xuất</th><th></th></tr></thead>
                <tbody>
                    <tr>
                        <td>
                            <select name="productId" class="form-select form-select-sm">
                                <option value="">— Chọn —</option>
                                @foreach (var p in products) { <option value="@p.Id">@p.Code — @p.Name</option> }
                            </select>
                        </td>
                        <td><input name="qty" type="number" min="0" value="0" class="form-control form-control-sm" /></td>
                        <td><input name="productionDate" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control form-control-sm" /></td>
                        <td><button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest('tr').remove()"><i class="bi bi-x"></i></button></td>
                    </tr>
                </tbody>
            </table>
            <button type="button" class="btn btn-sm btn-outline-primary" onclick="addRow()"><i class="bi bi-plus-lg me-1"></i>Thêm dòng</button>
            <div class="mt-3"><button class="btn btn-primary"><i class="bi bi-box-arrow-in-down me-1"></i>Tạo phiếu</button> <a href="/InventoryIn" class="btn btn-outline-secondary">Hủy</a></div>
        </form>
    }
</div></div>

@section Scripts {
<script>
    function addRow() {
        var tb = document.querySelector('#lines tbody');
        var row = tb.rows[0].cloneNode(true);
        row.querySelector('select').value = '';
        row.querySelector('input[name=qty]').value = 0;
        tb.appendChild(row);
    }
</script>
}
