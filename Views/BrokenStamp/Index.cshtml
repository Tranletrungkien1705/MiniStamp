@model List<BrokenStamp>
@{ ViewData["Title"] = "Tem rách/vỡ"; }
<div class="card"><div class="card-body">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="fw-bold mb-0">Phiếu ghi nhận tem rách/vỡ (NG)</h6>
        <a href="/BrokenStamp/Create" class="btn btn-sm btn-primary"><i class="bi bi-exclamation-octagon me-1"></i>Ghi nhận tem lỗi</a>
    </div>
    <p class="text-muted small">Tem rách/vỡ bị loại khỏi vòng đời (đánh dấu <b>Broken</b>) — không thể kích hoạt bảo hành hay quay thưởng.</p>
    <table class="table table-hover align-middle">
        <thead><tr><th>Mã phiếu</th><th>Sản phẩm</th><th class="text-end">SL tem lỗi</th><th>Trạng thái</th><th>Tạo</th></tr></thead>
        <tbody>
        @foreach (var b in Model)
        {
            <tr style="cursor:pointer" onclick="location.href='/BrokenStamp/Detail/@b.Id'">
                <td class="fw-semibold">@b.BsNo</td><td>@b.Product.Name</td>
                <td class="text-end">@b.Quantity.ToString("N0")</td>
                <td><span class="badge bg-warning text-dark">@b.Status</span></td>
                <td class="small text-muted">@b.CreatedAt.ToString("dd/MM/yyyy")</td>
            </tr>
        }
        @if (Model.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-4">Chưa có phiếu tem lỗi nào.</td></tr> }
        </tbody>
    </table>
</div></div>
