@{
    ViewData["Title"] = "Tạo phiếu xuất kho theo hộp";
}
<div class="card" style="max-width:900px"><div class="card-body">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div class="row g-3 mb-2">
            <div class="col-md-4"><label class="form-label small text-muted">Mã phiếu xuất</label><input name="bsNo" class="form-control" placeholder="Để trống sẽ tự sinh" /></div>
            <div class="col-md-4"><label class="form-label small text-muted">Mã khách hàng</label><input name="customerCode" class="form-control" placeholder="VD: KH001" /></div>
            <div class="col-md-4"><label class="form-label small text-muted">Tên khách hàng</label><input name="customerName" class="form-control" /></div>
        </div>
        <div class="row g-3 mb-2">
            <div class="col-md-6"><label class="form-label small text-muted">Địa chỉ khách</label><input name="customerAddress" class="form-control" /></div>
            <div class="col-md-3"><label class="form-label small text-muted">Biển số xe</label><input name="plateNo" class="form-control" /></div>
            <div class="col-md-3"><label class="form-label small text-muted">Số mooc</label><input name="moocNo" class="form-control" /></div>
        </div>
        <div class="row g-3 mb-2">
            <div class="col-md-3"><label class="form-label small text-muted">Tài xế</label><input name="driverName" class="form-control" /></div>
            <div class="col-md-3"><label class="form-label small text-muted">SĐT tài xế</label><input name="driverPhoneNo" class="form-control" /></div>
            <div class="col-md-3"><label class="form-label small text-muted">Loại vận chuyển</label><input name="transportType" class="form-control" placeholder="VD: Đường bộ" /></div>
            <div class="col-md-3"><label class="form-label small text-muted">Nơi nhận</label><input name="receivePlace" class="form-control" /></div>
        </div>
        <div class="row g-3 mb-2">
            <div class="col-md-4"><label class="form-label small text-muted">RefNoSys (đơn hàng nguồn)</label><input name="refNoSys" class="form-control" /></div>
            <div class="col-md-4"><label class="form-label small text-muted">RefNo</label><input name="refNo" class="form-control" /></div>
            <div class="col-md-4"><label class="form-label small text-muted">RefType</label><input name="refType" class="form-control" /></div>
        </div>
        <div class="mb-2"><label class="form-label small text-muted">Ghi chú</label><input name="remark" class="form-control" /></div>
        <label class="form-label small text-muted">Danh sách mã quét (mỗi dòng 1 mã)</label>
        <textarea name="codes" class="form-control" rows="6" style="font-family:monospace" placeholder="Mã tem lẻ:  A1B2C3D4E5F6&#10;Mã hộp:     BOX:BOX-SEED-001&#10;Hoặc chỉ gõ mã hộp nếu đã chọn loại BOX..."></textarea>
        <div class="form-text">Mặc định mỗi mã là <b>tem lẻ (ID)</b>. Muốn quét theo hộp, gõ tiền tố <code>BOX:</code> trước mã hộp (vd <code>BOX:BOX-SEED-001</code>). Có thể gõ <code>ID:</code> để chỉ định rõ tem lẻ.</div>
        <div class="mt-3"><button class="btn btn-primary"><i class="bi bi-box-arrow-up me-1"></i>Tạo phiếu xuất</button> <a href="/BoxShipment" class="btn btn-outline-secondary">Hủy</a></div>
    </form>
</div></div>
