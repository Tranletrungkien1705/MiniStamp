@model List<BoxShipment>
@{ ViewData["Title"] = "Xuất kho theo hộp"; }
<div class="card"><div class="card-body">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="fw-bold mb-0">Phiếu xuất kho theo hộp (Inv_InventoryVerifiedID_OutByBox)</h6>
        <a href="/BoxShipment/Create" class="btn btn-sm btn-primary"><i class="bi bi-box-arrow-up me-1"></i>Tạo phiếu xuất</a>
    </div>
    <p class="text-muted small">Xuất kho bằng cách <b>quét mã</b>: mỗi mã quét là 1 tem lẻ (<code>ID</code>) hoặc 1 <b>mã hộp</b> (<code>BOX</code>). Hệ thống tự bung hộp ra toàn bộ tem con rồi ghi phiếu. Phiếu tạo ở trạng thái <b>PENDING</b>, xuất xong chuyển <b>SHIPPED</b>.</p>
    <table class="table table-hover align-middle">
        <thead><tr><th>Mã phiếu</th><th>Khách hàng</th><th>Vận chuyển</th><th class="text-end">Số tem</th><th>Trạng thái</th><th>Tạo</th></tr></thead>
        <tbody>
        @foreach (var s in Model)
        {
            <tr style="cursor:pointer" onclick="location.href='/BoxShipment/Detail/@s.Id'">
                <td class="fw-semibold" style="font-family:monospace">@s.BsNo</td>
                <td>@(string.IsNullOrWhiteSpace(s.CustomerName) ? s.CustomerCode : s.CustomerName)</td>
                <td class="small text-muted">@s.PlateNo @(string.IsNullOrWhiteSpace(s.ReceivePlace) ? "" : "· " + s.ReceivePlace)</td>
                <td class="text-end">@s.Lines.Count</td>
                <td>
                    @if (s.Status == "SHIPPED") { <span class="badge bg-success">SHIPPED</span> }
                    else if (s.Status == "CANCEL") { <span class="badge bg-secondary">CANCEL</span> }
                    else { <span class="badge bg-warning text-dark">PENDING</span> }
                </td>
                <td class="small text-muted">@s.CreatedAt.ToString("dd/MM/yyyy")</td>
            </tr>
        }
        @if (Model.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-4">Chưa có phiếu xuất kho theo hộp nào.</td></tr> }
        </tbody>
    </table>
</div></div>
