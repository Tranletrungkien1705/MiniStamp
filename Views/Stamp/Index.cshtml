@model List<Stamp>
@{ ViewData["Title"] = "Tra tem"; var q = (string?)ViewBag.Q; }
<div class="card"><div class="card-body">
    <form method="get" class="row g-2 mb-3">
        <div class="col-md-5"><input name="q" value="@q" class="form-control" placeholder="Mã QR hoặc PIN..." /></div>
        <div class="col-auto"><button class="btn btn-primary">Tìm</button></div>
    </form>
    <table class="table table-hover align-middle">
        <thead><tr><th>Mã QR</th><th>PIN</th><th>Sản phẩm</th><th>Lô</th><th>Quét</th><th>Kích hoạt</th><th>Trạng thái</th></tr></thead>
        <tbody>
        @foreach (var s in Model)
        {
            var (st, css) = Ui.Status(s.Status);
            <tr>
                <td style="font-family:monospace" class="fw-semibold"><a href="/Verify?code=@s.QrId" target="_blank">@s.QrId</a></td>
                <td class="small">@s.Pin</td>
                <td>@s.Product.Name</td>
                <td class="small text-muted">@s.Batch.LotNo</td>
                <td class="text-center">@s.ScanCount</td>
                <td class="small text-muted">@(s.ActivatedAt?.ToString("dd/MM/yyyy") ?? "—")</td>
                <td><span class="badge bg-@css">@st</span></td>
            </tr>
        }
        @if (Model.Count == 0) { <tr><td colspan="7" class="text-center text-muted py-4">Không có tem.</td></tr> }
        </tbody>
    </table>
    @if (Model.Count == 500) { <div class="text-muted small">Hiển thị tối đa 500 tem — lọc bằng ô tìm kiếm.</div> }
</div></div>
