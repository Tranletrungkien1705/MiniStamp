@model List<ReqInvOut>
@{ ViewData["Title"] = "Yêu cầu xuất kho"; }
<div class="card"><div class="card-body">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="fw-bold mb-0">Phiếu yêu cầu xuất kho</h6>
        <a href="/ReqInvOut/Create" class="btn btn-sm btn-primary"><i class="bi bi-file-earmark-plus me-1"></i>Tạo yêu cầu</a>
    </div>
    <p class="text-muted small">Lập yêu cầu xuất kho theo mặt hàng + số lượng. Phiếu tạo ở trạng thái <b>PENDING</b>, duyệt xong chuyển <b>APPROVE</b> và gắn với phiếu xuất kho theo tem.</p>
    <table class="table table-hover align-middle">
        <thead><tr><th>Mã yêu cầu</th><th>Số yêu cầu</th><th class="text-end">Số dòng</th><th class="text-end">Tổng SL</th><th>Trạng thái</th><th>Tạo</th></tr></thead>
        <tbody>
        @foreach (var r in Model)
        {
            <tr style="cursor:pointer" onclick="location.href='/ReqInvOut/Detail/@r.Id'">
                <td class="fw-semibold" style="font-family:monospace">@r.ReqInvOutNo</td>
                <td>@r.RefNo</td>
                <td class="text-end">@r.Lines.Count</td>
                <td class="text-end">@r.Lines.Sum(l => l.Qty).ToString("N0")</td>
                <td>
                    @if (r.ReqStatus == "APPROVE") { <span class="badge bg-success">APPROVE</span> }
                    else { <span class="badge bg-warning text-dark">PENDING</span> }
                </td>
                <td class="small text-muted">@r.CreatedAt.ToString("dd/MM/yyyy")</td>
            </tr>
        }
        @if (Model.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-4">Chưa có yêu cầu xuất kho nào.</td></tr> }
        </tbody>
    </table>
</div></div>