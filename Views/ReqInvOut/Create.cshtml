@{
    ViewData["Title"] = "Tạo yêu cầu xuất kho";
    var products = (List<Product>)ViewBag.Products;
}
<div class="card" style="max-width:960px"><div class="card-body">
    @if (products.Count == 0)
    {
        <div class="alert alert-warning">Chưa có sản phẩm. <a href="/Product/Create">Tạo sản phẩm</a> trước.</div>
    }
    else
    {
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="row g-3 mb-2">
                <div class="col-md-4"><label class="form-label small text-muted">Mã yêu cầu</label><input name="reqInvOutNo" class="form-control" placeholder="Để trống sẽ tự sinh" /></div>
                <div class="col-md-4"><label class="form-label small text-muted">Số yêu cầu (RefNo) *</label><input name="refNo" class="form-control" placeholder="VD: YC-2026-001" /></div>
                <div class="col-md-4"><label class="form-label small text-muted">Ngày xuất</label><input name="invOutDate" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" /></div>
                <div class="col-md-3"><label class="form-label small text-muted">Mã kho</label><input name="invCode" class="form-control" placeholder="VD: KHO01" /></div>
                <div class="col-md-3"><label class="form-label small text-muted">Loại xuất kho</label><input name="invOutType" class="form-control" placeholder="VD: THUONGMAI" /></div>
                <div class="col-md-3"><label class="form-label small text-muted">Loại phương tiện</label><input name="transportType" class="form-control" placeholder="VD: Đường bộ" /></div>
                <div class="col-md-3"><label class="form-label small text-muted">Biển số xe</label><input name="vehicleNumber" class="form-control" placeholder="VD: 29C-123.45" /></div>
                <div class="col-md-4"><label class="form-label small text-muted">Mã khách hàng</label><input name="customerCodeSys" class="form-control" placeholder="VD: KH001" /></div>
                <div class="col-md-8"><label class="form-label small text-muted">Địa điểm nhận hàng</label><input name="receiveAddress" class="form-control" placeholder="VD: Kho đại lý Phú Thọ" /></div>
                <div class="col-12"><label class="form-label small text-muted">Ghi chú</label><input name="remark" class="form-control" placeholder="VD: Yêu cầu xuất lô tháng 9" /></div>
            </div>
            <label class="form-label small text-muted">Chi tiết yêu cầu (mỗi dòng 1 mặt hàng)</label>
            <table class="table table-sm align-middle" id="lines">
                <thead><tr><th style="width:34%">Mặt hàng</th><th style="width:14%">Số lượng</th><th style="width:14%">Đơn vị</th><th style="width:12%">KM</th><th style="width:20%">Ghi chú</th><th></th></tr></thead>
                <tbody>
                    <tr>
                        <td>
                            <select name="productId" class="form-select form-select-sm">
                                <option value="">— Chọn —</option>
                                @foreach (var p in products) { <option value="@p.Id">@p.Code — @p.Name</option> }
                            </select>
                        </td>
                        <td><input name="qty" type="number" min="0" value="0" class="form-control form-control-sm" /></td>
                        <td><input name="unitCode" class="form-control form-control-sm" placeholder="Bao" /></td>
                        <td class="text-center"><input name="flagDiscount" type="checkbox" value="true" class="form-check-input" /></td>
                        <td><input name="lineRemark" class="form-control form-control-sm" /></td>
                        <td><button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest('tr').remove()"><i class="bi bi-x"></i></button></td>
                    </tr>
                </tbody>
            </table>
            <button type="button" class="btn btn-sm btn-outline-primary" onclick="addRow()"><i class="bi bi-plus-lg me-1"></i>Thêm dòng</button>
            <div class="mt-3"><button class="btn btn-primary"><i class="bi bi-file-earmark-plus me-1"></i>Tạo yêu cầu</button> <a href="/ReqInvOut" class="btn btn-outline-secondary">Hủy</a></div>
        </form>
    }
</div></div>

@section Scripts {
<script>
    function addRow() {
        var tb = document.querySelector('#lines tbody');
        var row = tb.rows[0].cloneNode(true);
        row.querySelector('select').value = '';
        row.querySelector('input[name=qty]').value = 0;
        row.querySelector('input[name=unitCode]').value = '';
        row.querySelector('input[name=flagDiscount]').checked = false;
        row.querySelector('input[name=lineRemark]').value = '';
        tb.appendChild(row);
    }
</script>
}