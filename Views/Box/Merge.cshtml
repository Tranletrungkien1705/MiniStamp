@{
    ViewData["Title"] = "Gộp tem vào hộp";
    var products = (List<Product>)ViewBag.Products;
}
<div class="card" style="max-width:720px"><div class="card-body">
    <h6 class="fw-bold mb-1">Gộp tem vào 1 hộp mới</h6>
    <p class="text-muted small">Nghiệp vụ <b>Map_IDInBox_Merge</b> của EQR: gom 1 danh sách tem (IDNo) vào 1 hộp mới.
        Tem đang thuộc hộp khác sẽ được gỡ khỏi hộp cũ rồi gộp vào hộp mới; hệ thống ghi 1 bản ghi lịch sử (RefType=MERGE) để truy vết.</p>
    @if (products.Count == 0)
    {
        <div class="alert alert-warning">Chưa có sản phẩm. <a href="/Product/Create">Tạo sản phẩm</a> trước.</div>
    }
    else
    {
        <form asp-action="Merge" method="post">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-md-7"><label class="form-label small text-muted">Sản phẩm *</label>
                    <select name="productId" class="form-select" required>
                        <option value="">— Chọn —</option>
                        @foreach (var p in products) { <option value="@p.Id">@p.Code — @p.Name</option> }
                    </select>
                </div>
                <div class="col-md-5"><label class="form-label small text-muted">Mã hộp mới</label><input name="boxNo" class="form-control" placeholder="Để trống sẽ tự sinh" /></div>
                <div class="col-12"><label class="form-label small text-muted">Danh sách mã tem (mỗi dòng 1 mã, hoặc cách nhau bởi dấu phẩy)</label>
                    <textarea name="codes" rows="6" class="form-control" style="font-family:monospace" placeholder="A1B2C3D4E5F6&#10;..."></textarea>
                </div>
            </div>
            <div class="mt-3"><button class="btn btn-primary"><i class="bi bi-boxes me-1"></i>Gộp vào hộp</button> <a href="/Box" class="btn btn-outline-secondary">Hủy</a></div>
        </form>
    }
</div></div>
