@model List<Box>
@{ ViewData["Title"] = "Hộp tem"; }
<div class="card"><div class="card-body">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="fw-bold mb-0">Các hộp đã đóng gói</h6>
        <a href="/Box/Create" class="btn btn-sm btn-primary"><i class="bi bi-box-seam me-1"></i>Đóng hộp tem</a>
    </div>
    <table class="table table-hover align-middle">
        <thead><tr><th>Mã hộp</th><th>Sản phẩm</th><th class="text-end">SL tem</th><th>Tạo</th></tr></thead>
        <tbody>
        @foreach (var b in Model)
        {
            <tr style="cursor:pointer" onclick="location.href='/Box/Detail/@b.Id'">
                <td class="fw-semibold">@b.BoxNo</td><td>@b.Product.Name</td>
                <td class="text-end">@b.Quantity.ToString("N0")</td>
                <td class="small text-muted">@b.CreatedAt.ToString("dd/MM/yyyy")</td>
            </tr>
        }
        @if (Model.Count == 0) { <tr><td colspan="4" class="text-center text-muted py-4">Chưa có hộp nào.</td></tr> }
        </tbody>
    </table>
</div></div>
