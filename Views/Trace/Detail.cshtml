@model TraceEvent
@{ ViewData["Title"] = $"Sự kiện {Model.EventNo}"; }
<div class="card mb-3"><div class="card-body">
    <div class="d-flex justify-content-between flex-wrap gap-2">
        <div>
            <h5 class="fw-bold mb-1">Sự kiện truy xuất <span style="font-family:monospace">@Model.EventNo</span></h5>
            <div class="text-muted small">
                Loại <b>@Model.CteCode</b> · tạo lúc @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm") bởi @Model.CreatedBy
                @if (Model.UpdatedAt != null) { <text> · cập nhật @Model.UpdatedAt?.ToString("dd/MM/yyyy HH:mm")</text> }
            </div>
        </div>
        <div class="d-flex flex-column align-items-end gap-2">
            <span class="badge bg-success">@Model.Status</span>
            <a href="/Trace" class="btn btn-sm btn-outline-primary">Danh sách</a>
        </div>
    </div>
</div></div>

<div class="card"><div class="card-body">
    <h6 class="fw-bold mb-3">Thông tin sự kiện</h6>
    <div class="row g-3 mb-3">
        <div class="col-md-4"><div class="text-muted small">Kiểu hiển thị</div><div class="fw-semibold">@Model.UIStyleCode</div></div>
        <div class="col-md-4"><div class="text-muted small">Mã địa điểm GS1 (GLN)</div><div class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.GLNOrgCode) ? "—" : Model.GLNOrgCode)</div></div>
        <div class="col-md-4"><div class="text-muted small">Template hiển thị</div><div class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.TplVECode) ? "—" : Model.TplVECode)</div></div>
        <div class="col-12"><div class="text-muted small">Ghi chú</div><div class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.Remark) ? "—" : Model.Remark)</div></div>
    </div>
    <h6 class="fw-bold mb-2">Trường dữ liệu (KDE)</h6>
    <table class="table table-sm align-middle">
        <thead><tr><th>Mã KDE</th><th>Giá trị</th></tr></thead>
        <tbody>
        @foreach (var s in Model.Specs)
        {
            <tr><td style="font-family:monospace">@s.KdeCode</td><td>@s.KdeValue</td></tr>
        }
        @if (Model.Specs.Count == 0) { <tr><td colspan="2" class="text-center text-muted py-3">Không có trường dữ liệu.</td></tr> }
        </tbody>
    </table>
</div></div>