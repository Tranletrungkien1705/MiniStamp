@model Block
@{ ViewData["Title"] = $"Block {Model.BlockNo}"; }
<div class="card mb-3"><div class="card-body">
    <div class="d-flex justify-content-between flex-wrap gap-2">
        <div>
            <h5 class="fw-bold mb-1">Block <span style="font-family:monospace">@Model.BlockNo</span></h5>
            <div class="text-muted small">Gom lúc @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm") bởi @Model.CreatedBy</div>
        </div>
        <a href="/Block" class="btn btn-sm btn-outline-primary align-self-start">Danh sách block</a>
    </div>
</div></div>

<div class="card mb-3"><div class="card-body">
    <h6 class="fw-bold mb-3">Thông tin block</h6>
    <div class="row g-3">
        <div class="col-6 col-md-3"><div class="small text-muted">Sản phẩm</div><div class="fw-semibold">@Model.Product?.Name</div></div>
        <div class="col-6 col-md-3"><div class="small text-muted">Loại block</div><div><span class="badge text-bg-secondary">@Model.BlockType</span></div></div>
        <div class="col-6 col-md-3"><div class="small text-muted">Số tem</div><div class="fw-semibold">@Model.QtyVerified / @Model.Qty</div></div>
        <div class="col-6 col-md-3"><div class="small text-muted">Mã cục bộ</div><div>@(Model.BlockLocalID ?? "—")</div></div>
        <div class="col-6 col-md-3"><div class="small text-muted">Mã lô</div><div>@(Model.LotCode ?? "—")</div></div>
        <div class="col-6 col-md-3"><div class="small text-muted">Ca sản xuất</div><div>@(Model.ShiftCode ?? "—")</div></div>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.Remark))
    {
        <div class="mt-3 text-muted small"><i class="bi bi-chat-left-text me-1"></i>@Model.Remark</div>
    }
</div></div>

<div class="card"><div class="card-body">
    <h6 class="fw-bold mb-3">Tem trong block (@Model.Lines.Count)</h6>
    <table class="table table-sm table-hover align-middle">
        <thead><tr><th>#</th><th>Mã tem</th><th>Thêm lúc</th></tr></thead>
        <tbody>
        @{ var i = 0; }
        @foreach (var l in Model.Lines)
        {
            i++;
            <tr>
                <td class="text-muted">@i</td>
                <td style="font-family:monospace">@l.QrId</td>
                <td class="small text-muted">@l.AddedAt.ToString("dd/MM/yyyy HH:mm")</td>
            </tr>
        }
        @if (Model.Lines.Count == 0) { <tr><td colspan="3" class="text-center text-muted py-4">Block chưa có tem.</td></tr> }
        </tbody>
    </table>
</div></div>