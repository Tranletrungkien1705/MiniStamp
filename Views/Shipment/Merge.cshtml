@{
    ViewData["Title"] = "Gộp phiếu xuất kho theo tem";
}
<div class="card" style="max-width:760px"><div class="card-body">
    <h6 class="fw-bold mb-1">Gộp phiếu xuất kho theo tem (Inv_VerifiedIDInOut_Merge)</h6>
    <p class="text-muted small">
        Gộp các phiếu xuất kho <b>trùng khóa</b> (cùng RefNoSys + sản phẩm + UserMoveOrder) về 1 phiếu duy nhất.
        Mỗi lượt, hệ thống chuyển toàn bộ tem của phiếu <b>ít tem nhất</b> sang phiếu còn lại rồi xóa phiếu đó,
        lặp cho tới khi chỉ còn 1 phiếu. Cần ít nhất 2 phiếu cùng khóa mới gộp được.
    </p>
    <form asp-action="Merge" method="post">
        @Html.AntiForgeryToken()
        <div class="row g-3 mb-2">
            <div class="col-md-4"><label class="form-label small text-muted">RefNoSys (đơn hàng nguồn)</label><input name="refNoSys" class="form-control" placeholder="VD: DH-SEED-001" /></div>
            <div class="col-md-4"><label class="form-label small text-muted">Mã sản phẩm (ProductCode)</label><input name="productCode" class="form-control" placeholder="VD: SP001" /></div>
            <div class="col-md-4"><label class="form-label small text-muted">UserMoveOrder (lệnh điều chuyển)</label><input name="userMoveOrder" class="form-control" placeholder="VD: LENH-01" /></div>
        </div>
        <div class="mt-3">
            <button class="btn btn-primary"><i class="bi bi-arrows-collapse me-1"></i>Gộp phiếu</button>
            <a href="/Shipment" class="btn btn-outline-secondary">Hủy</a>
        </div>
    </form>
</div></div>
