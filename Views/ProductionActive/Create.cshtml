@{
    ViewData["Title"] = "Kích hoạt thông tin sản xuất";
    var products = (List<Product>)ViewBag.Products;
    var lives = (List<ProductLife>)ViewBag.ProductLives;
}
<div class="card" style="max-width:860px"><div class="card-body">
    @if (products.Count == 0)
    {
        <div class="alert alert-warning">Chưa có sản phẩm. <a href="/Product/Create">Tạo sản phẩm</a> trước.</div>
    }
    else
    {
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="row g-3 mb-2">
                <div class="col-md-4"><label class="form-label small text-muted">Mã phiếu kích hoạt</label><input name="paNo" class="form-control" placeholder="Để trống sẽ tự sinh" /></div>
                <div class="col-md-4"><label class="form-label small text-muted">Số tham chiếu (RefNo) <span class="text-danger">*</span></label><input name="refNo" class="form-control" placeholder="VD: DH-2026-001" /></div>
                <div class="col-md-4"><label class="form-label small text-muted">Nguồn gốc (Origin) <span class="text-danger">*</span></label><input name="origin" class="form-control" placeholder="VD: Trang trại VietGAP 1030" /></div>
            </div>
            <div class="row g-3 mb-2">
                <div class="col-md-4">
                    <label class="form-label small text-muted">Sản phẩm</label>
                    <select name="productId" class="form-select">
                        <option value="">— Chọn —</option>
                        @foreach (var p in products) { <option value="@p.Id">@p.Code — @p.Name</option> }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label small text-muted">Hạn sử dụng</label>
                    <select name="productLifeId" class="form-select">
                        <option value="">— Chọn —</option>
                        @foreach (var l in lives) { <option value="@l.Id">@l.Name (@l.ValueByDay ngày)</option> }
                    </select>
                </div>
                <div class="col-md-4"><label class="form-label small text-muted">Số lượng kế hoạch</label><input name="qtyPlan" type="number" min="0" value="0" class="form-control" /></div>
            </div>
            <div class="row g-3 mb-2">
                <div class="col-md-4"><label class="form-label small text-muted">Ngày sản xuất</label><input name="productDate" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" /></div>
                <div class="col-md-8"><label class="form-label small text-muted">Dải serial tem vào SX <span class="text-danger">*</span></label><input name="listSerialIn" class="form-control" placeholder="VD: 000001-000100" /></div>
            </div>
            <div class="row g-3 mb-2">
                <div class="col-md-8 offset-md-4"><label class="form-label small text-muted">Dải serial tem ra SX</label><input name="listSerialOut" class="form-control" placeholder="VD: 000001-000100" /></div>
            </div>
            <div class="alert alert-light border small mb-3"><i class="bi bi-info-circle me-1"></i>Ngày hết hạn sẽ được tính tự động = Ngày sản xuất + hạn sử dụng − 1.</div>
            <div class="mt-3"><button class="btn btn-primary"><i class="bi bi-play-circle me-1"></i>Kích hoạt</button> <a href="/ProductionActive" class="btn btn-outline-secondary">Hủy</a></div>
        </form>
    }
</div></div>