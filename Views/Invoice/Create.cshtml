@{
    ViewData["Title"] = "Tạo hóa đơn điện tử";
    var products = (List<Product>)ViewBag.Products;
}
<div class="card" style="max-width:980px"><div class="card-body">
    @if (products.Count == 0)
    {
        <div class="alert alert-warning">Chưa có sản phẩm. <a href="/Product/Create">Tạo sản phẩm</a> trước.</div>
    }
    else
    {
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="row g-3 mb-2">
                <div class="col-md-4"><label class="form-label small text-muted">Mã hóa đơn (InvoiceCode) <span class="text-danger">*</span></label><input name="invoiceCode" class="form-control" placeholder="VD: HD001" /></div>
                <div class="col-md-4"><label class="form-label small text-muted">Mẫu hóa đơn (TInvoiceCode)</label><input name="tinvoiceCode" class="form-control" placeholder="VD: MAU01" /></div>
                <div class="col-md-4"><label class="form-label small text-muted">Ngày hóa đơn</label><input name="invoiceDate" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" /></div>
            </div>
            <div class="row g-3 mb-2">
                <div class="col-md-3"><label class="form-label small text-muted">Số HĐ bắt đầu</label><input name="invoiceNoStart" type="number" value="1" class="form-control" /></div>
                <div class="col-md-3"><label class="form-label small text-muted">Số HĐ kết thúc</label><input name="invoiceNoEnd" type="number" value="100" class="form-control" /></div>
                <div class="col-md-3"><label class="form-label small text-muted">MST (đơn vị phát hành)</label><input name="mst" class="form-control" placeholder="Mã số thuế" /></div>
                <div class="col-md-3"><label class="form-label small text-muted">Hình thức TT (PaymentMethodCode)</label><input name="paymentMethodCode" class="form-control" placeholder="VD: TM" /></div>
            </div>
            <div class="row g-3 mb-2">
                <div class="col-md-4"><label class="form-label small text-muted">Số tham chiếu (RefNo)</label><input name="refNo" class="form-control" /></div>
                <div class="col-md-4"><label class="form-label small text-muted">Mã KH (CustomerNNTCode)</label><input name="customerNntCode" class="form-control" /></div>
                <div class="col-md-4"><label class="form-label small text-muted">MST bên mua</label><input name="customerMst" class="form-control" /></div>
            </div>
            <div class="row g-3 mb-2">
                <div class="col-md-4"><label class="form-label small text-muted">Tên bên mua</label><input name="customerNntName" class="form-control" /></div>
                <div class="col-md-4"><label class="form-label small text-muted">Địa chỉ</label><input name="customerNntAddress" class="form-control" /></div>
                <div class="col-md-2"><label class="form-label small text-muted">Điện thoại</label><input name="customerNntPhone" class="form-control" /></div>
                <div class="col-md-2"><label class="form-label small text-muted">Email</label><input name="customerNntEmail" class="form-control" /></div>
            </div>

            <label class="form-label small text-muted">Chi tiết hóa đơn (mỗi dòng 1 mặt hàng)</label>
            <table class="table table-sm align-middle" id="lines">
                <thead><tr><th style="width:40%">Mặt hàng</th><th style="width:20%">Số lượng</th><th style="width:30%">Đơn giá</th><th></th></tr></thead>
                <tbody>
                    <tr>
                        <td>
                            <select name="productId" class="form-select form-select-sm">
                                <option value="">— Chọn —</option>
                                @foreach (var p in products) { <option value="@p.Id">@p.Code — @p.Name</option> }
                            </select>
                        </td>
                        <td><input name="qty" type="number" min="0" value="0" class="form-control form-control-sm" /></td>
                        <td><input name="unitPrice" type="number" min="0" step="1000" value="0" class="form-control form-control-sm" /></td>
                        <td><button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest('tr').remove()"><i class="bi bi-x"></i></button></td>
                    </tr>
                </tbody>
            </table>
            <button type="button" class="btn btn-sm btn-outline-primary" onclick="addRow()"><i class="bi bi-plus-lg me-1"></i>Thêm dòng</button>

            <div class="row g-3 mt-1 mb-2">
                <div class="col-md-4"><label class="form-label small text-muted">Tiền thuế VAT (TotalValVAT)</label><input name="totalValVat" type="number" min="0" step="1000" value="0" class="form-control" /></div>
                <div class="col-md-8"><label class="form-label small text-muted">Ghi chú</label><input name="remark" class="form-control" /></div>
            </div>
            <div class="alert alert-light border small mb-3"><i class="bi bi-info-circle me-1"></i>Tiền hàng và tổng thanh toán sẽ được tính tự động từ các dòng (thành tiền = SL × đơn giá; tổng TT = tiền hàng + VAT).</div>

            <div class="mt-3"><button class="btn btn-primary"><i class="bi bi-save me-1"></i>Tạo hóa đơn</button> <a href="/Invoice" class="btn btn-outline-secondary">Hủy</a></div>
        </form>
    }
</div></div>

@section Scripts {
<script>
    function addRow() {
        var tb = document.querySelector('#lines tbody');
        var row = tb.rows[0].cloneNode(true);
        row.querySelector('select').value = '';
        row.querySelector('input[name=qty]').value = 0;
        row.querySelector('input[name=unitPrice]').value = 0;
        tb.appendChild(row);
    }
</script>
}