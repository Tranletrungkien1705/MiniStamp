@model VerifyResult?
@{
    Layout = null;
    ViewData["Title"] = "Tra cứu tem chống giả";
    var code = (string?)ViewBag.Code ?? "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Tra cứu tem chống giả — MiniStamp</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
<style>
  body { background:#0b1220; min-height:100vh; font-family:"Be Vietnam Pro",sans-serif; -webkit-font-smoothing:antialiased; padding:18px 12px; }
  .wrap { max-width:440px; margin:0 auto; }
  .brand { color:#fff; text-align:center; font-weight:800; font-size:22px; margin-bottom:16px; }
  .brand span { color:#fca5a5; }
  .card { border:none; border-radius:16px; box-shadow:0 10px 40px rgba(0,0,0,.4); }
  .banner { border-radius:16px 16px 0 0; padding:26px 20px; text-align:center; color:#fff; }
  .banner.ok { background:linear-gradient(135deg,#16a34a,#15803d); }
  .banner.bad { background:linear-gradient(135deg,#dc2626,#991b1b); }
  .banner .ico { font-size:52px; }
  .banner h4 { font-weight:800; margin:6px 0 2px; }
  .kv { display:flex; justify-content:space-between; padding:9px 0; border-bottom:1px solid #f0f0f5; font-size:14px; }
  .kv .k { color:#6b7280; } .kv .v { font-weight:600; text-align:right; }
</style>
</head>
<body>
<div class="wrap">
  <div class="brand"><i class="bi bi-patch-check-fill"></i> Mini<span>Stamp</span> · Tra cứu chống giả</div>

  @if (TempData["Success"] != null) { <div class="alert alert-success"><i class="bi bi-check-circle me-1"></i>@TempData["Success"]</div> }
  @if (TempData["Error"] != null) { <div class="alert alert-danger"><i class="bi bi-x-circle me-1"></i>@TempData["Error"]</div> }

  <div class="card mb-3"><div class="card-body">
    <form method="get" action="/Verify" class="d-flex gap-2">
      <input name="code" value="@code" class="form-control" placeholder="Nhập mã tem trên sản phẩm..." autofocus />
      <button class="btn btn-danger"><i class="bi bi-search"></i></button>
    </form>
    <div class="text-muted small mt-2">Quét QR trên tem hoặc nhập mã để kiểm tra hàng chính hãng.</div>
  </div></div>

  @if (Model != null)
  {
    <div class="card">
      <div class="banner @(Model.Genuine ? "ok" : "bad")">
        <div class="ico"><i class="bi @(Model.Genuine ? "bi-shield-fill-check" : "bi-shield-fill-exclamation")"></i></div>
        <h4>@Model.Title</h4>
        <div style="opacity:.9">@Model.Message</div>
      </div>
      <div class="card-body">
        @if (Model.Found && Model.Product != null)
        {
          <div class="kv"><span class="k">Sản phẩm</span><span class="v">@Model.Product.Name</span></div>
          <div class="kv"><span class="k">Nhà sản xuất</span><span class="v">@(Model.Product.Manufacturer ?? "—")</span></div>
          <div class="kv"><span class="k">Số lô SX</span><span class="v">@(Model.Batch?.LotNo ?? "—")</span></div>
          <div class="kv"><span class="k">Ngày sản xuất</span><span class="v">@(Model.Batch?.MfgDate.ToString("dd/MM/yyyy"))</span></div>
          <div class="kv"><span class="k">Số lần tra cứu</span><span class="v">@Model.Stamp?.ScanCount</span></div>
          @if (Model.Stamp?.WarrantyEnd != null) { <div class="kv"><span class="k">Bảo hành đến</span><span class="v">@Model.Stamp.WarrantyEnd?.ToString("dd/MM/yyyy")</span></div> }

          @foreach (var w in Model.Warnings)
          { <div class="alert alert-warning py-2 px-3 mt-2 mb-0 small"><i class="bi bi-exclamation-triangle me-1"></i>@w</div> }

          @if (Model.Genuine && Model.Stamp?.ActivatedAt == null)
          {
            <form method="post" action="/Verify/Activate" class="mt-3 d-flex gap-2">
              <input type="hidden" name="code" value="@Model.Stamp!.QrId" />
              <input name="phone" class="form-control" placeholder="SĐT kích hoạt bảo hành" />
              <button class="btn btn-success text-nowrap"><i class="bi bi-shield-check me-1"></i>Kích hoạt</button>
            </form>
          }
          @if (Model.Genuine && Model.Stamp?.HasSpun != true)
          {
            <form method="post" action="/Verify/Spin" class="mt-2">
              <input type="hidden" name="code" value="@Model.Stamp!.QrId" />
              <button class="btn btn-outline-danger w-100"><i class="bi bi-gift me-1"></i>Quét tem trúng thưởng — Quay ngay</button>
            </form>
          }
          else if (Model.Stamp?.HasSpun == true)
          {
            <div class="alert alert-info py-2 px-3 mt-2 mb-0 small"><i class="bi bi-gift me-1"></i>Đã quay thưởng: <b>@Model.Stamp.PrizeWon</b></div>
          }
        }
        else
        {
          <div class="text-center text-muted">Nếu bạn chắc chắn mua hàng chính hãng, hãy liên hệ nhà sản xuất — mã tem không hợp lệ có thể là dấu hiệu hàng giả.</div>
        }
      </div>
    </div>
  }

  <div class="text-center mt-3" style="color:#64748b;font-size:12px">MiniStamp — demo tem chống giả &amp; truy xuất nguồn gốc</div>
</div>
</body>
</html>
