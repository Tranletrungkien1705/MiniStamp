@{ ViewData["Title"] = "Chốt kỳ vòng đời tem"; }
<div class="card"><div class="card-body">
    <h6 class="fw-bold mb-3">Chốt vòng đời tem theo kỳ tháng</h6>
    <p class="text-muted small">Nghiệp vụ <b>InvIVID_LifeCircleIDNoByPeriod</b> (EQR): chốt số liệu vòng đời tem cho 1 kỳ tháng. Mỗi kỳ chỉ chốt được 1 lần; chênh lệch (Δ) được tính so với kỳ trước liền kề đã chốt.</p>

    <form method="post" action="/Lifecycle/Create">
        @Html.AntiForgeryToken()
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label small text-muted">Kỳ tháng <span class="text-danger">*</span></label>
                <input type="month" name="periodMonth" class="form-control" required />
                <div class="form-text">Chọn tháng cần chốt (hệ thống tự chuẩn hoá về ngày đầu tháng).</div>
            </div>
            <div class="col-md-8">
                <label class="form-label small text-muted">Ghi chú</label>
                <input name="remark" class="form-control" placeholder="vd: chốt số liệu tháng theo yêu cầu" />
            </div>
        </div>
        <div class="mt-3">
            <button class="btn btn-primary"><i class="bi bi-check2-circle me-1"></i>Chốt kỳ</button>
            <a href="/Lifecycle" class="btn btn-outline-secondary">Hủy</a>
        </div>
    </form>
</div></div>