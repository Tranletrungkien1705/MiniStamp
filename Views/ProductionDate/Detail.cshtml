@model StampProductionDateLog
@{ ViewData["Title"] = $"Cập nhật ngày SX {Model.LogNo}"; }
<div class="card mb-3"><div class="card-body">
    <div class="d-flex justify-content-between flex-wrap gap-2">
        <div>
            <h5 class="fw-bold mb-1">Cập nhật ngày sản xuất <span style="font-family:monospace">@Model.LogNo</span></h5>
            <div class="text-muted small">
                Thực hiện lúc @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm") bởi @Model.CreatedBy
            </div>
        </div>
        <div class="d-flex flex-column align-items-end gap-2">
            <span class="badge bg-success">@Model.Quantity tem</span>
            <a href="/ProductionDate" class="btn btn-sm btn-outline-primary">Danh sách</a>
        </div>
    </div>
</div></div>

<div class="card mb-3"><div class="card-body">
    <h6 class="fw-bold mb-3">Thông tin lần cập nhật</h6>
    <div class="row g-3">
        <div class="col-md-4"><div class="text-muted small">Ngày sản xuất được gán</div><div class="fw-semibold text-success">@Model.ProductionDTime.ToString("dd/MM/yyyy HH:mm")</div></div>
        <div class="col-md-4"><div class="text-muted small">Số tem cập nhật</div><div class="fw-semibold">@Model.Quantity.ToString("N0")</div></div>
        <div class="col-md-4"><div class="text-muted small">Người cập nhật</div><div class="fw-semibold">@Model.CreatedBy</div></div>
        @if (!string.IsNullOrWhiteSpace(Model.Remark))
        {
            <div class="col-12"><div class="text-muted small">Ghi chú</div><div class="fw-semibold">@Model.Remark</div></div>
        }
    </div>
</div></div>

<div class="card"><div class="card-body">
    <h6 class="fw-bold mb-3">Danh sách tem đã cập nhật (@Model.Lines.Count)</h6>
    <table class="table table-sm table-hover align-middle">
        <thead><tr><th>Mã tem (IDNo)</th><th>Ngày SX trước đó</th><th>Ngày SX mới</th></tr></thead>
        <tbody>
        @foreach (var l in Model.Lines)
        {
            <tr>
                <td style="font-family:monospace">@l.QrId</td>
                <td class="small text-muted">@(l.OldProductionDTime == null ? "—" : l.OldProductionDTime.Value.ToString("dd/MM/yyyy HH:mm"))</td>
                <td class="small fw-semibold">@Model.ProductionDTime.ToString("dd/MM/yyyy HH:mm")</td>
            </tr>
        }
        @if (Model.Lines.Count == 0) { <tr><td colspan="3" class="text-center text-muted py-4">Không có tem nào.</td></tr> }
        </tbody>
    </table>
</div></div>
