@{
    ViewData["Title"] = "Cập nhật ngày sản xuất";
}
<div class="card" style="max-width:860px"><div class="card-body">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div class="row g-3 mb-2">
            <div class="col-md-6">
                <label class="form-label small text-muted">Ngày sản xuất (ProductionDTimeUTC)</label>
                <input name="productionDTime" type="datetime-local" class="form-control" />
                <div class="form-text">Để trống sẽ lấy thời điểm hiện tại (đúng EQR).</div>
            </div>
            <div class="col-md-6"><label class="form-label small text-muted">Ghi chú</label><input name="remark" class="form-control" placeholder="VD: chỉnh lại ngày SX lô L2026-001" /></div>
        </div>
        <div class="mb-2">
            <label class="form-label small text-muted">Danh sách tem (IDNo) <span class="text-danger">*</span></label>
            <textarea name="codes" rows="6" class="form-control" style="font-family:monospace" placeholder="Mỗi dòng 1 mã tem, hoặc cách nhau bởi dấu phẩy / khoảng trắng"></textarea>
            <div class="form-text">Mọi tem phải tồn tại trong kho tem. Ngày SX mới sẽ được gán cho toàn bộ tem trong danh sách.</div>
        </div>
        <div class="mt-3"><button class="btn btn-primary"><i class="bi bi-calendar-check me-1"></i>Cập nhật ngày SX</button> <a href="/ProductionDate" class="btn btn-outline-secondary">Hủy</a></div>
    </form>
</div></div>
