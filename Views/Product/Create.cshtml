@{ ViewData["Title"] = "Thêm sản phẩm"; }
<div class="card" style="max-width:640px"><div class="card-body">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div class="row g-3">
            <div class="col-md-8"><label class="form-label small text-muted">Tên sản phẩm *</label><input name="name" class="form-control" required /></div>
            <div class="col-md-4"><label class="form-label small text-muted">Mã (tự sinh nếu trống)</label><input name="code" class="form-control" placeholder="SP00x" /></div>
            <div class="col-md-8"><label class="form-label small text-muted">Nhà sản xuất</label><input name="manufacturer" class="form-control" /></div>
            <div class="col-md-4"><label class="form-label small text-muted">Bảo hành (tháng)</label><input name="warrantyMonths" type="number" value="12" class="form-control" /></div>
            <div class="col-12"><label class="form-label small text-muted">Mô tả</label><textarea name="description" class="form-control" rows="2"></textarea></div>
        </div>
        <div class="mt-3"><button class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Lưu</button> <a href="/Product" class="btn btn-outline-secondary">Hủy</a></div>
    </form>
</div></div>
