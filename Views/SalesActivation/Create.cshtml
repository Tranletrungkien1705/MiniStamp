@{
    ViewData["Title"] = "Kích hoạt bán hàng";
}
<div class="card" style="max-width:900px"><div class="card-body">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div class="row g-3 mb-2">
            <div class="col-md-4"><label class="form-label small text-muted">Mã phiếu</label><input name="saNo" class="form-control" placeholder="Để trống sẽ tự sinh (PXKHT...)" /></div>
            <div class="col-md-4">
                <label class="form-label small text-muted">Sản phẩm</label>
                <select name="productId" class="form-select">
                    <option value="0">— Chọn sản phẩm —</option>
                    @foreach (var p in (List<Product>)ViewBag.Products)
                    { <option value="@p.Id">@p.Code — @p.Name</option> }
                </select>
            </div>
            <div class="col-md-4"><label class="form-label small text-muted">Mốc kích hoạt bán</label><input name="salesDTime" type="datetime-local" class="form-control" /></div>
        </div>
        <div class="row g-3 mb-2">
            <div class="col-md-4"><label class="form-label small text-muted">Mã khách hàng</label><input name="customerCode" class="form-control" placeholder="VD: KH001" /></div>
            <div class="col-md-4"><label class="form-label small text-muted">Tên khách hàng</label><input name="customerName" class="form-control" /></div>
            <div class="col-md-4"><label class="form-label small text-muted">Ghi chú</label><input name="remark" class="form-control" /></div>
        </div>
        <label class="form-label small text-muted">Danh sách mã tem đã bán (mỗi dòng 1 mã, hoặc cách nhau bởi dấu phẩy/khoảng trắng)</label>
        <textarea name="codes" class="form-control" rows="6" style="font-family:monospace" placeholder="Dán danh sách QrId tem đã bán..."></textarea>
        <div class="mt-3"><button class="btn btn-primary"><i class="bi bi-cart-check me-1"></i>Kích hoạt bán</button> <a href="/SalesActivation" class="btn btn-outline-secondary">Hủy</a></div>
    </form>
</div></div>