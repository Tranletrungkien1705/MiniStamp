@model SalesActivation
@{
    ViewData["Title"] = $"Phiếu kích hoạt bán {Model.SaNo}";
}
<div class="card mb-3"><div class="card-body">
    <div class="d-flex justify-content-between flex-wrap gap-2">
        <div>
            <h5 class="fw-bold mb-1">Phiếu kích hoạt bán hàng <span style="font-family:monospace">@Model.SaNo</span></h5>
            <div class="text-muted small">
                @Model.Quantity tem · tạo lúc @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
            </div>
            <div class="text-muted small">Sản phẩm: <b>@Model.Product.Code — @Model.Product.Name</b></div>
            @if (!string.IsNullOrWhiteSpace(Model.CustomerName) || !string.IsNullOrWhiteSpace(Model.CustomerCode))
            { <div class="text-muted small">Khách hàng: <b>@Model.CustomerName</b> @(string.IsNullOrWhiteSpace(Model.CustomerCode) ? "" : $"({Model.CustomerCode})")</div> }
            <div class="text-muted small">Mốc kích hoạt bán: @Model.SalesDTime.ToString("dd/MM/yyyy HH:mm")</div>
            @if (!string.IsNullOrWhiteSpace(Model.RefNoSys)) { <div class="text-muted small">Phiếu xuất nội bộ: @Model.RefNoSys (@Model.RefType)</div> }
            @if (!string.IsNullOrWhiteSpace(Model.Remark)) { <div class="text-muted small">Ghi chú: @Model.Remark</div> }
        </div>
        <div class="d-flex flex-column align-items-end gap-2">
            <span class="badge bg-success">ĐÃ KÍCH HOẠT BÁN</span>
            <form asp-action="Revert" asp-route-id="@Model.Id" method="post" class="d-flex gap-1"
                  onsubmit="return confirm('Hoàn tác kích hoạt bán @Model.SaNo? Tem trong phiếu sẽ trở về trạng thái chưa bán.');">
                @Html.AntiForgeryToken()
                <input name="reason" class="form-control form-control-sm" style="width:180px" placeholder="Lý do (tùy chọn)" />
                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-arrow-counterclockwise me-1"></i>Hoàn tác</button>
            </form>
            <a href="/SalesActivation" class="btn btn-sm btn-outline-primary">Danh sách phiếu</a>
        </div>
    </div>
</div></div>

<div class="card"><div class="card-body">
    <h6 class="fw-bold mb-1">Chi tiết tem đã bán</h6>
    <table class="table table-sm align-middle">
        <thead><tr><th>#</th><th>Mã tem (QrId)</th><th>Mốc bán</th></tr></thead>
        <tbody>
        @{ var i = 0; }
        @foreach (var l in Model.Lines)
        {
            i++;
            <tr>
                <td class="text-muted">@i</td>
                <td style="font-family:monospace">@l.QrId</td>
                <td class="small text-muted">@l.SalesDTime.ToString("dd/MM/yyyy HH:mm")</td>
            </tr>
        }
        </tbody>
        <tfoot><tr><th colspan="2" class="text-end">Tổng</th><th>@Model.Lines.Count tem</th></tr></tfoot>
    </table>
</div></div>