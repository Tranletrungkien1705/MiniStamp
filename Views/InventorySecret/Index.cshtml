@model List<InventorySecret>
@{ ViewData["Title"] = "Tem bí mật"; var flagUsed = ViewBag.FlagUsed as bool?; }
<div class="card mb-3"><div class="card-body">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h6 class="fw-bold mb-0">Serial bí mật</h6>
        <div class="d-flex gap-2">
            <a href="/InventorySecret/Create" class="btn btn-sm btn-primary"><i class="bi bi-plus-lg me-1"></i>Tạo serial</a>
            <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#markUsedModal"><i class="bi bi-check2-square me-1"></i>Đánh dấu đã dùng</button>
        </div>
    </div>
    <p class="text-muted small">Nghiệp vụ <b>Inv_InventorySecret</b> (EQR): dãy serial bí mật sinh kèm tem để đối soát/đánh dấu đã dùng. Serial chưa dùng mới đánh dấu được; serial phải thuộc đúng MST.</p>
    <form method="get" class="row g-2 mb-3">
        <div class="col-md-5"><input name="q" value="@ViewBag.Q" class="form-control form-control-sm" placeholder="Tìm theo SerialNo / QR_SerialNo" /></div>
        <div class="col-md-3">
            <select name="flagUsed" class="form-select form-select-sm">
                <option value="">— Tất cả trạng thái —</option>
                <option value="false" selected="@(flagUsed == false)">Chưa dùng</option>
                <option value="true" selected="@(flagUsed == true)">Đã dùng</option>
            </select>
        </div>
        <div class="col-md-2"><button class="btn btn-sm btn-outline-secondary w-100">Lọc</button></div>
    </form>
    <table class="table table-hover align-middle">
        <thead><tr><th>SerialNo</th><th>QR_SerialNo</th><th>MST</th><th>Lô sinh</th><th>Trạng thái</th><th>Đánh dấu</th></tr></thead>
        <tbody>
        @foreach (var s in Model)
        {
            <tr style="cursor:pointer" onclick="location.href='/InventorySecret/Detail/@s.Id'">
                <td class="fw-semibold" style="font-family:monospace">@s.SerialNo</td>
                <td style="font-family:monospace">@(s.QrSerialNo ?? "—")</td>
                <td>@(s.Mst ?? "—")</td>
                <td class="small text-muted">@(s.GenTimesNo ?? "—")</td>
                <td>
                    @if (s.FlagUsed) { <span class="badge text-bg-success">Đã dùng</span> }
                    else { <span class="badge text-bg-secondary">Chưa dùng</span> }
                </td>
                <td class="small text-muted">@(s.UsedAt?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
            </tr>
        }
        @if (Model.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-4">Chưa có serial bí mật nào.</td></tr> }
        </tbody>
    </table>
</div></div>

<div class="modal fade" id="markUsedModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content">
    <form asp-action="MarkUsed" method="post">
        @Html.AntiForgeryToken()
        <div class="modal-header"><h6 class="modal-title fw-bold">Đánh dấu serial đã dùng</h6><button class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
            <div class="mb-2"><label class="form-label small text-muted">Danh sách SerialNo * (mỗi dòng 1 mã, hoặc cách nhau bởi dấu phẩy)</label>
                <textarea name="serials" class="form-control" rows="4" style="font-family:monospace" required></textarea></div>
            <div><label class="form-label small text-muted">MST (để trống = bỏ qua kiểm tra MST)</label>
                <input name="mst" class="form-control" placeholder="vd 2600123456" /></div>
        </div>
        <div class="modal-footer"><button class="btn btn-primary">Đánh dấu đã dùng</button></div>
    </form>
</div></div></div>
