@{
    ViewData["Title"] = "Tạo phiếu xuất kho thành phẩm";
    var products = (List<Product>)ViewBag.Products;
}
<div class="card" style="max-width:960px"><div class="card-body">
    @if (products.Count == 0)
    {
        <div class="alert alert-warning">Chưa có sản phẩm. <a href="/Product/Create">Tạo sản phẩm</a> trước.</div>
    }
    else
    {
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="row g-3 mb-2">
                <div class="col-md-4"><label class="form-label small text-muted">Mã phiếu xuất</label><input name="invOutFGNo" class="form-control" placeholder="Để trống sẽ tự sinh" /></div>
                <div class="col-md-4"><label class="form-label small text-muted">MST (đơn vị xuất)</label><input name="mst" class="form-control" placeholder="Mã số thuế" /></div>
                <div class="col-md-4">
                    <label class="form-label small text-muted">Loại xuất (InvFOutType)</label>
                    <select name="invFOutType" class="form-select">
                        <option value="OUTTHUONGMAI">Xuất thương mại (OUTTHUONGMAI)</option>
                        <option value="OUTENDCUS">Xuất cho người tiêu dùng (OUTENDCUS)</option>
                    </select>
                </div>
            </div>
            <div class="row g-3 mb-2">
                <div class="col-md-3"><label class="form-label small text-muted">Loại phiếu (FormOutType)</label>
                    <select name="formOutType" class="form-select">
                        <option value="KHONGMAVACH">Không mã vạch</option>
                        <option value="MAVACH">Có mã vạch</option>
                    </select>
                </div>
                <div class="col-md-3"><label class="form-label small text-muted">Loại xuất kho (InvOutType)</label><input name="invOutType" class="form-control" placeholder="VD: BT" /></div>
                <div class="col-md-3"><label class="form-label small text-muted">Mã kho (InvCode)</label><input name="invCode" class="form-control" placeholder="VD: KHO01" /></div>
                <div class="col-md-3"><label class="form-label small text-muted">PMType</label><input name="pmType" class="form-control" /></div>
            </div>
            <div class="row g-3 mb-2">
                <div class="col-md-3"><label class="form-label small text-muted">Biển số xe</label><input name="plateNo" class="form-control" /></div>
                <div class="col-md-3"><label class="form-label small text-muted">Số mooc</label><input name="moocNo" class="form-control" /></div>
                <div class="col-md-3"><label class="form-label small text-muted">Tài xế</label><input name="driverName" class="form-control" /></div>
                <div class="col-md-3"><label class="form-label small text-muted">SĐT tài xế</label><input name="driverPhoneNo" class="form-control" /></div>
            </div>
            <div class="row g-3 mb-3">
                <div class="col-md-4"><label class="form-label small text-muted">Mã đại lý (AgentCode)</label><input name="agentCode" class="form-control" /></div>
                <div class="col-md-4"><label class="form-label small text-muted">Tên khách hàng</label><input name="customerName" class="form-control" /></div>
                <div class="col-md-4"><label class="form-label small text-muted">Ghi chú</label><input name="remark" class="form-control" /></div>
            </div>

            <label class="form-label small text-muted">Chi tiết xuất kho (mỗi dòng 1 mặt hàng)</label>
            <table class="table table-sm align-middle" id="lines">
                <thead><tr><th style="width:35%">Mặt hàng</th><th style="width:15%">Số lượng</th><th style="width:40%">Serial (mỗi dòng 1 mã, tùy chọn)</th><th></th></tr></thead>
                <tbody>
                    <tr>
                        <td>
                            <select name="productId" class="form-select form-select-sm">
                                <option value="">— Chọn —</option>
                                @foreach (var p in products) { <option value="@p.Id">@p.Code — @p.Name</option> }
                            </select>
                        </td>
                        <td><input name="qty" type="number" min="0" value="0" class="form-control form-control-sm" /></td>
                        <td><textarea name="serialNo" rows="1" class="form-control form-control-sm" placeholder="SN001&#10;SN002"></textarea></td>
                        <td><button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest('tr').remove()"><i class="bi bi-x"></i></button></td>
                    </tr>
                </tbody>
            </table>
            <button type="button" class="btn btn-sm btn-outline-primary" onclick="addRow()"><i class="bi bi-plus-lg me-1"></i>Thêm dòng</button>
            <div class="mt-3"><button class="btn btn-primary"><i class="bi bi-box-arrow-up me-1"></i>Tạo phiếu</button> <a href="/InventoryOut" class="btn btn-outline-secondary">Hủy</a></div>
        </form>
    }
</div></div>

@section Scripts {
<script>
    function addRow() {
        var tb = document.querySelector('#lines tbody');
        var row = tb.rows[0].cloneNode(true);
        row.querySelector('select').value = '';
        row.querySelector('input[name=qty]').value = 0;
        row.querySelector('textarea[name=serialNo]').value = '';
        tb.appendChild(row);
    }
</script>
}