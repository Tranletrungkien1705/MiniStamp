@model StampPair
@{ ViewData["Title"] = $"Cặp tem #{Model.Id}"; }
<div class="card mb-3"><div class="card-body">
    <div class="d-flex justify-content-between flex-wrap gap-2">
        <div>
            <h5 class="fw-bold mb-1">Cặp tem đã ghép</h5>
            <div class="text-muted small">Ghép lúc @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm") bởi @Model.CreatedBy</div>
        </div>
        <a href="/StampPair" class="btn btn-sm btn-outline-primary align-self-start">Danh sách cặp tem</a>
    </div>
</div></div>

<div class="card"><div class="card-body">
    <h6 class="fw-bold mb-3">Tem chính ↔ Tem phụ</h6>
    <div class="row g-4">
        <div class="col-6 col-md-3 text-center">
            <div class="small text-muted mb-1">Tem chính</div>
            <img src="/Stamp/Qr?code=@Model.MainQrId&px=4" class="img-fluid border rounded" style="max-width:130px" alt="QR" />
            <div class="small mt-1" style="font-family:monospace">@Model.MainQrId</div>
        </div>
        <div class="col-6 col-md-3 text-center">
            <div class="small text-muted mb-1">Tem phụ</div>
            <img src="/Stamp/Qr?code=@Model.SubQrId&px=4" class="img-fluid border rounded" style="max-width:130px" alt="QR" />
            <div class="small mt-1" style="font-family:monospace">@Model.SubQrId</div>
        </div>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.Remark))
    {
        <div class="mt-3 text-muted small"><i class="bi bi-chat-left-text me-1"></i>@Model.Remark</div>
    }
</div></div>