@{
    ViewData["Title"] = "Gán tem vào thùng";
}
<div class="card" style="max-width:720px"><div class="card-body">
    <p class="text-muted small">Gán trực tiếp các tem lẻ vào 1 thùng (Can) — nghiệp vụ <b>Inv_InventoryVerifiedID_UpdCan</b> của EQR.
        Khác với "Đóng thùng" (gom hộp vào thùng): ở đây gán từng con tem vào thùng, không qua hộp.</p>
    <form asp-action="Assign" method="post">
        @Html.AntiForgeryToken()
        <div class="row g-3">
            <div class="col-md-5"><label class="form-label small text-muted">Mã thùng *</label>
                <input name="canNo" class="form-control" placeholder="vd CAN-SEED-001" required />
            </div>
            <div class="col-12"><label class="form-label small text-muted">Danh sách mã tem (mỗi dòng 1 mã, hoặc cách nhau bởi dấu phẩy)</label>
                <textarea name="codes" rows="6" class="form-control" style="font-family:monospace" placeholder="mã tem..."></textarea>
            </div>
        </div>
        <div class="mt-3"><button class="btn btn-primary"><i class="bi bi-box-arrow-in-down me-1"></i>Gán vào thùng</button> <a href="/Carton" class="btn btn-outline-secondary">Hủy</a></div>
    </form>
</div></div>
