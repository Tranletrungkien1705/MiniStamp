@{
    ViewData["Title"] = "Đóng thùng tem";
    var products = (List<Product>)ViewBag.Products;
}
<div class="card" style="max-width:720px"><div class="card-body">
    @if (products.Count == 0)
    {
        <div class="alert alert-warning">Chưa có sản phẩm. <a href="/Product/Create">Tạo sản phẩm</a> trước.</div>
    }
    else
    {
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-md-7"><label class="form-label small text-muted">Sản phẩm *</label>
                    <select name="productId" class="form-select" required>
                        <option value="">— Chọn —</option>
                        @foreach (var p in products) { <option value="@p.Id">@p.Code — @p.Name</option> }
                    </select>
                </div>
                <div class="col-md-5"><label class="form-label small text-muted">Mã thùng</label><input name="canNo" class="form-control" placeholder="Để trống sẽ tự sinh" /></div>
                <div class="col-12"><label class="form-label small text-muted">Danh sách mã hộp (mỗi dòng 1 mã, hoặc cách nhau bởi dấu phẩy)</label>
                    <textarea name="boxNos" rows="6" class="form-control" style="font-family:monospace" placeholder="BOX-SEED-001&#10;..."></textarea>
                </div>
            </div>
            <div class="mt-3"><button class="btn btn-primary"><i class="bi bi-boxes me-1"></i>Đóng thùng</button> <a href="/Carton" class="btn btn-outline-secondary">Hủy</a></div>
        </form>
    }
</div></div>
